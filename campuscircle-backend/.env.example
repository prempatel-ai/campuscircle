# Copy this file to .env and fill in real values before running.
# .env is gitignored — never commit real secrets.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://campuscircle:campuscircle@db:5432/campuscircle

# Generate a real random secret before Phase 3 (auth). For now, any placeholder is fine.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
